# Server
PORT=8787
TZ=Asia/Shanghai

# Huawei AppGallery Connect / Health Kit (服务器应用)
# 填真实值前请勿提交 .env；此处仅为占位
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=http://localhost:8787/oauth/callback

# 可选：华为 OAuth / Health Kit 端点（一般用默认即可）
# HUAWEI_OAUTH_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
# HUAWEI_HEALTH_API_BASE=https://health-api.cloud.huawei.com/healthkit/v2

# 本地 mock：无 token 时 POST /pull 写假数据
ALLOW_MOCK_PULL=true
